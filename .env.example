# ─── AI Provider API Keys ──────────────────────────────────────────────────────
# At least one is required. Keys are stored in the DB and survive restarts.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
TAVILY_API_KEY=tvly-...

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the frontend is served from.
# Local:  http://localhost:3000
# Remote: http://YOUR_SERVER_IP:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ─── Frontend → Backend URL ───────────────────────────────────────────────────
# The URL browsers use to reach the backend. Baked into the JS bundle at build.
# Local:  http://localhost:8000
# Remote: http://YOUR_SERVER_IP:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite default (file lives in the sdr_db Docker volume).
# Swap for PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:////app/data/sdr.db

# ─── Default LLM (overridden per-session via Settings UI) ─────────────────────
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-6
